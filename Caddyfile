{
	admin off
	auto_https off
}

:80 {
	request_body {
		max_size 30MB
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080 {
			# Preserve the address supplied by an outer reverse proxy (for
			# example, the Nginx setup documented in README.md). Caddy
			# otherwise replaces X-Forwarded-For with the proxy's address.
			trusted_proxies private_ranges
		}
	}

	redir /admin /admin/

	handle /admin/* {
		uri strip_prefix /admin
		root * /work/admin
		try_files {path} {path}/ /index.html
		file_server
	}

	# Keep this allowlist and policy in sync with Caddyfile.dev and next.config.ts.
	map {path} {upload_content_type} {upload_disposition} {
		default application/octet-stream attachment
		~(?i)\.png$ image/png inline
		~(?i)\.jpe?g$ image/jpeg inline
		~(?i)\.gif$ image/gif inline
		~(?i)\.webp$ image/webp inline
		~(?i)\.svg$ image/svg+xml inline
	}

	handle_path /upload-img/* {
		# Even legacy SVG documents must not run scripts or retain our origin.
		header {
			Content-Security-Policy "sandbox; default-src 'none'; img-src data:; style-src 'unsafe-inline'"
			X-Content-Type-Options nosniff
			Content-Type {upload_content_type}
			Content-Disposition {upload_disposition}
		}
		root * /work/frontend/public/upload-img
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	log {
		output stdout
		format console
	}
}
