{
	admin off
	auto_https off
}

:80 {
	request_body {
		max_size 30MB
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080 {
			# Preserve the address supplied by an outer reverse proxy (for
			# example, the Nginx setup documented in README.md). Caddy
			# otherwise replaces X-Forwarded-For with the proxy's address.
			trusted_proxies private_ranges
		}
	}

	redir /admin /admin/

	handle /admin/* {
		uri strip_prefix /admin
		root * /work/admin
		try_files {path} {path}/ /index.html
		file_server
	}

	handle_path /upload-img/* {
		root * /work/frontend/public/upload-img
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	log {
		output stdout
		format console
	}
}
