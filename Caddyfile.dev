{
	admin off
	auto_https off
}

:80 {
	request_body {
		max_size 30MB
	}

	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAM:127.0.0.1:8080} {
			# The backend uses the client IP for emoji rate limiting. Trust
			# the local/container network so Caddy keeps the original IP
			# forwarded by an outer proxy.
			trusted_proxies private_ranges
		}
	}

	# Keep this allowlist and policy in sync with Caddyfile and next.config.ts.
	map {path} {upload_content_type} {upload_disposition} {
		default application/octet-stream attachment
		~(?i)\.png$ image/png inline
		~(?i)\.jpe?g$ image/jpeg inline
		~(?i)\.gif$ image/gif inline
		~(?i)\.webp$ image/webp inline
		~(?i)\.svg$ image/svg+xml inline
	}

	handle_path /upload-img/* {
		# Even legacy SVG documents must not run scripts or retain our origin.
		header {
			Content-Security-Policy "sandbox; default-src 'none'; img-src data:; style-src 'unsafe-inline'"
			X-Content-Type-Options nosniff
			Content-Type {upload_content_type}
			Content-Disposition {upload_disposition}
		}
		root * /srv/uploads
		file_server
	}

	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy {$ADMIN_UPSTREAM:127.0.0.1:3001}
	}

	handle {
		reverse_proxy {$FRONTEND_UPSTREAM:127.0.0.1:3000}
	}

	log {
		output stdout
		format console
	}
}
